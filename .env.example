# Copie para .env e configure antes de executar. Nunca versione o .env real.
SECRET_KEY=troque-por-uma-chave-aleatoria-de-pelo-menos-32-caracteres
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=rota_financeira_db
DB_USER=rota_financeira_app
DB_PASSWORD=defina-a-senha-do-usuario-do-banco
APP_HOST=127.0.0.1
APP_PORT=5000
# Ative apenas com HTTPS. Para localhost HTTP, mantenha false.
SESSION_COOKIE_SECURE=false
# Memória serve para uma instância local. Em múltiplas instâncias use Redis.
RATELIMIT_STORAGE_URI=memory://
